{
  "name": "@arkyn/ui",
  "version": "0.1.0",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "private": false,
  "license": "Apache-2.0",
  "author": "Arkyn | Lucas Gonçalves",
  "description": "Pre-built sidebar, header, and admin layout components for building React admin panels and CRUD dashboards faster.",
  "keywords": [
    "react",
    "remix",
    "next",
    "react-router",
    "admin",
    "dashboard",
    "sidebar",
    "header",
    "layout",
    "crud",
    "typescript",
    "design-system"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "homepage": "https://docs.arkyn.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lucas-Eduardo-Goncalves/arkyn-library.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "LICENSE.txt",
    "styles.d.ts"
  ],
  "scripts": {
    "audit": "bun audit",
    "build": "bunx vite build && bun ./generate-component-styles.ts && bunx tsc --project tsconfig.json --emitDeclarationOnly && bun ./generate-exports.ts && rm -f dist/modules/index.js dist/modules/style.css",
    "prebuild": "rm -rf dist",
    "publish:beta": "bash ../../scripts/publish-idempotent.sh beta",
    "publish:latest": "bash ../../scripts/publish-idempotent.sh latest",
    "release:beta": "bun ../../scripts/generate-version.ts beta",
    "release:patch": "bun ../../scripts/generate-version.ts patch",
    "release:minor": "bun ../../scripts/generate-version.ts minor",
    "release:major": "bun ../../scripts/generate-version.ts major",
    "test": "bunx vitest --config vitest.config.ts --run",
    "test:watch": "bunx vitest --config vitest.config.ts --watch",
    "typecheck": "bunx tsc --project tsconfig.json --noEmit"
  },
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {},
  "peerDependencies": {
    "lucide-react": ">=1.14.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^30.0.1",
    "lucide-react": "catalog:",
    "postcss": "^8.5.16",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles": {
      "import": "./dist/style.css",
      "types": "./styles.d.ts",
      "default": "./dist/style.css"
    },
    "./adminLayoutContent": {

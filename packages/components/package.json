{
	"name": "@arkyn/components",
	"version": "3.0.11",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"private": false,
	"license": "Apache-2.0",
	"author": "Arkyn | Lucas Gonçalves",
	"description": "A modern React component library, featuring 40+ UI components, smooth animations, custom hooks, and TypeScript support.",
	"keywords": [
		"react",
		"remix",
		"next",
		"astro",
		"react-router",
		"components",
		"ui",
		"typescript",
		"hooks",
		"forms",
		"design-system"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=18.0.0",
		"bun": ">=1.0.0"
	},
	"homepage": "https://docs.arkyn.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Lucas-Eduardo-Goncalves/arkyn-library.git",
		"directory": "packages/components"
	},
	"files": [
		"dist",
		"README.md",
		"AGENTS.md",
		"LICENSE.txt",
		"styles.d.ts"
	],
	"scripts": {
		"audit": "bun audit",
		"build": "bunx vite build && bun ./generate-component-styles.ts && bunx tsc --project tsconfig.json --emitDeclarationOnly && bun ./generate-exports.ts && rm -f dist/modules/index.js dist/modules/style.css",
		"prebuild": "rm -rf dist",
		"publish:beta": "bash ../../scripts/publish-idempotent.sh beta",
		"publish:latest": "bash ../../scripts/publish-idempotent.sh latest",
		"release:beta": "bun ../../scripts/generate-version.ts beta",
		"release:patch": "bun ../../scripts/generate-version.ts patch",
		"release:minor": "bun ../../scripts/generate-version.ts minor",
		"release:major": "bun ../../scripts/generate-version.ts major",
		"test": "bunx vitest --config vitest.config.ts --run",
		"test:watch": "bunx vitest --config vitest.config.ts --watch",
		"typecheck": "bunx tsc --project tsconfig.json --noEmit && bunx tsc --project tsconfig.scripts.json --noEmit"
	},
	"sideEffects": [
		"*.css"
	],
	"dependencies": {
		"@arkyn/shared": "^3.0.2",
		"@arkyn/templates": "^3.0.2"
	},
	"peerDependencies": {
		"@react-google-maps/api": ">=2.0.0",

		"mapbox-gl": ">=3.0.0",
		"react": ">=18.0.0",
		"react-dom": ">=18.0.0",
		"react-hot-toast": ">=2.0.0",
		"react-scroll": ">=1.8.0",
		"slate": ">=0.100.0",
		"slate-history": ">=0.100.0",
		"slate-react": ">=0.100.0"
	},
	"peerDependenciesMeta": {
		"mapbox-gl": {
			"optional": true
		},
		"is-hotkey": {
			"optional": true
		},
		"slate": {
